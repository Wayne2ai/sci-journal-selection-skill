flowchart LR
    accTitle: SCI journal selection pipeline
    accDescr: From manuscript brief through preference gate, candidate pool over CAS zones 1-3, evidence checks, optional Jev or heuristic rank, to paste-ready table without acceptance prediction

    start_node(["Manuscript brief"]) ==> gate{"Preference gate"}

    gate -->|XinRui prefer default| zone_xr["Zone: XinRui first"]
    gate -->|CAS only| zone_cas["Zone: CAS first"]
    gate -->|No API key default| rank_h["Heuristic rank"]
    gate -->|API key on| rank_j["TypeSafe Jev"]

    zone_xr --> pool
    zone_cas --> pool
    rank_h --> pool
    rank_j --> pool

    pool["Candidate pool 15-40"] ==> verify["Verify metrics"]
    verify ==> prec["Precedents by year"]
    prec ==> sort{"Rank mode"}

    sort -->|Jev opted-in| jev_node["scope + precedent + zone"]
    sort -->|Heuristic default| heur_node["scope then recency then zone"]

    jev_node ==> out_node(["Paste-ready table"])
    heur_node ==> out_node

    csv_node[("FQBJCR2025 CSV")] -.-> verify
    csv_node -.-> pool

    subgraph coverage ["CAS 2025 zones in CSV"]
        z1["Z1 1451"]
        z2["Z2 2844"]
        z3["Z3 4583"]
        z13["Z1-3 = 8878 primary"]
        z4["Z4 12894 lookup only"]
        z1 --> z2 --> z3 --> z13
        z13 -.-> z4
    end

    coverage -.-> pool

    classDef primary fill:#2563eb,stroke:#1e40af,stroke-width:2px,color:#fff
    classDef success fill:#059669,stroke:#047857,stroke-width:2px,color:#fff
    classDef warn fill:#d97706,stroke:#b45309,stroke-width:2px,color:#fff
    classDef muted fill:#64748b,stroke:#475569,stroke-width:1px,color:#fff
    classDef store fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#fff
    classDef decision fill:#0ea5e9,stroke:#0369a1,stroke-width:2px,color:#fff

    class start_node,out_node success
    class gate,sort decision
    class pool,verify,prec primary
    class rank_h,heur_node,zone_xr muted
    class rank_j,jev_node warn
    class csv_node,z13 store
    class z4 muted
